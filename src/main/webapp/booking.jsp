<!DOCTYPE html>
<html>
<head>
    <title>Metro Booking</title>
</head>

<body>

<h2>Metro Ticket Booking</h2>

<form>

    Passenger Name:
    <input type="text" name="name">
    <br><br>

    Source:
    <input type="text" name="source">
    <br><br>

    Destination:
